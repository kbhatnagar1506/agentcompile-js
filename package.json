{
  "name": "agentcompile",
  "version": "0.3.0",
  "description": "Wrap your agent's model client: AgentCompile answers the jobs your agent repeats as verified routines, and forwards everything else to your model unchanged.",
  "license": "Apache-2.0",
  "author": "AgentCompile",
  "homepage": "https://github.com/kbhatnagar1506/agentcompile-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbhatnagar1506/agentcompile-js.git"
  },
  "bugs": {
    "url": "https://github.com/kbhatnagar1506/agentcompile-js/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "openai",
    "anthropic",
    "agent",
    "compiler",
    "observability"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "openai": "^7.25.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
